# A data breakpoint with a condition on the flash demo (start it first with start_in_flash):
# compute() writes g_result = 46 each time.

attach ../../dap-client/examples/tc275_demo_3cores.json
continue all
pause 0
wait stopped 0
watch g_result write if g_result == 46
continue 0
wait stopped 0 reason data breakpoint
expect g_result == 46
continue 0
wait stopped 0 reason data breakpoint
expect g_result == 46
