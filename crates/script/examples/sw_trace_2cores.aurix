# The software trace of two cores at once: the ORTI demo's on CPU0 (build_orti.ps1 -Trace,
# about 200 records a second) and trace_cpu1 on CPU1 (build_trace_cpu1.ps1, 2,200 records,
# 17.6 KB a second), started with start_in_flash (CPU1 with --core 1), RAM only.

include lib/trace_start.aurix ATTACH=../../dap-client/examples/tc275_trace_2cores.json

trace expect 1 job count >= 500 within 2s
trace expect 1 job interval avg >= 0.99ms
trace expect 1 job interval avg <= 1.01ms
trace expect 1 job span max <= 120us
trace expect 1 sample interval avg >= 4.9ms
trace expect 1 sample interval avg <= 5.1ms
trace expect 0 TimerIsr interval avg >= 9.9ms
trace expect 0 TimerIsr interval avg <= 10.1ms
sleep 2s
trace expect 0 dropped == 0
trace expect 1 dropped == 0

# The load: a job of 100 us every 1 ms is 10 % of CPU1; each task about a third of CPU0 (its
# 0.4 s of every 1.2 s, measured over some seconds), the timer ISR (3 us every 10 ms) 0.03 %.
trace expect 1 job load >= 9.5%
trace expect 1 job load <= 10.5%
trace expect 0 TaskA load >= 25%
trace expect 0 TaskA load <= 42%
trace expect 0 TimerIsr load < 0.1%
trace save ${TEMP}/sw_trace_2cores.csv

# How full the buffers got while the debugger read them (since the drop of the backlog).
let high0 = read live aurix_trace_high@0
let high1 = read live aurix_trace_high@1
print buffer high water: CPU0 ${high0} of 2048 B, CPU1 ${high1} of 4096 B
check high1 < 4000 && high0 < 2000
