# separate repository (github.com/najari/tas-sw)
/tas-sw/

# build output
build/
out/
/crates/target/
*.obj
*.pdb
*.ilk
*.exp
*.lib

# binaries: vendor tools (Infineon DAS) and locally built DLLs are not redistributed
*.exe
*.dll

# drop-in test folder: only the launcher script is tracked
/mcd_tas/drop_in/*
!/mcd_tas/drop_in/run_client.cmd

# runtime logs
*.log
# Live Watch expressions the debugger app keeps next to an attach file
*.watch
/app/target/
