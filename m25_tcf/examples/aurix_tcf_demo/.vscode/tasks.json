{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: demo.elf",
      "detail": "Link the demo for the CPU0 PSPR and DSPR (build.ps1); the same image runs on the TC275 and the TC36x",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build.ps1"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "TC275: build demo_flash.elf",
      "detail": "Link the demo for TC275 PF1 sector 0x8021C000 (build_flash.ps1)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build_flash.ps1", "-Board", "tc275"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "TC275: probe-rs start RAM demo on CPU0",
      "detail": "Build demo.elf, write it into the CPU0 PSPR and DSPR (no flash write) and halt CPU0 at main",
      "dependsOn": "build: demo.elf",
      "type": "process",
      "command": "D:\\work\\claude\\probe-rs\\target\\release\\examples\\start_in_flash.exe",
      "args": ["${workspaceFolder}\\build\\demo.elf"],
      "options": { "env": { "PROBE_RS_CHIP": "TC275" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC275: probe-rs flash demo (PF1 0x8021C000)",
      "detail": "Build demo_flash.elf and write it with probe-rs through the TAS server (PF1 sector 0x8021C000 only; skipped when the sector already holds it)",
      "dependsOn": "TC275: build demo_flash.elf",
      "type": "process",
      "command": "D:\\work\\claude\\probe-rs\\target\\release\\probe-rs.exe",
      "args": [
        "download", "--chip", "TC275", "--probe", "058b:0000", "--verify",
        "${workspaceFolder}\\build\\demo_flash.elf"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC275: probe-rs start flash demo on CPU0",
      "detail": "Flash the demo, then halt CPU0 at main of the flashed demo (PC, stack, A11 = PCXI = 0)",
      "dependsOn": "TC275: probe-rs flash demo (PF1 0x8021C000)",
      "type": "process",
      "command": "D:\\work\\claude\\probe-rs\\target\\release\\examples\\start_in_flash.exe",
      "args": ["${workspaceFolder}\\build\\demo_flash.elf"],
      "options": { "env": { "PROBE_RS_CHIP": "TC275" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC36x: build demo_flash_tc36x.elf",
      "detail": "Link the demo for TC36x PF1 sector 0x80400000 (build_flash.ps1 -Board tc36x)",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\build_flash.ps1", "-Board", "tc36x"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "silent", "panel": "shared", "clear": true }
    },
    {
      "label": "TC36x: probe-rs start RAM demo on CPU0",
      "detail": "Build demo.elf, write it into the CPU0 PSPR and DSPR of the TC36x (no flash write) and halt CPU0 at main",
      "dependsOn": "build: demo.elf",
      "type": "process",
      "command": "D:\\work\\claude\\probe-rs\\target\\release\\examples\\start_in_flash.exe",
      "args": ["${workspaceFolder}\\build\\demo.elf"],
      "options": { "env": { "PROBE_RS_CHIP": "TC36x" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC36x: probe-rs flash demo (PF1 0x80400000)",
      "detail": "Build demo_flash_tc36x.elf and write it with probe-rs through the TAS server (PF1 sector 0x80400000 only; skipped when the sector already holds it)",
      "dependsOn": "TC36x: build demo_flash_tc36x.elf",
      "type": "process",
      "command": "D:\\work\\claude\\probe-rs\\target\\release\\probe-rs.exe",
      "args": [
        "download", "--chip", "TC36x", "--probe", "058b:0000", "--verify",
        "${workspaceFolder}\\build\\demo_flash_tc36x.elf"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC36x: probe-rs start flash demo on CPU0",
      "detail": "Flash the demo, then halt CPU0 at main of the flashed demo (PC, stack, A11 = PCXI = 0)",
      "dependsOn": "TC36x: probe-rs flash demo (PF1 0x80400000)",
      "type": "process",
      "command": "D:\\work\\claude\\probe-rs\\target\\release\\examples\\start_in_flash.exe",
      "args": ["${workspaceFolder}\\build\\demo_flash_tc36x.elf"],
      "options": { "env": { "PROBE_RS_CHIP": "TC36x" } },
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC275: m25 flash demo (PF1 0x8021C000)",
      "detail": "Build demo_flash.elf, write it with the M25 flasher (PF1 sector 0x8021C000 only), reset, run",
      "dependsOn": "TC275: build demo_flash.elf",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\..\\..\\tools\\m25_flash_task.ps1",
        "-Elf", "${workspaceFolder}\\build\\demo_flash.elf",
        "-Agent", "${workspaceFolder}\\agent\\tcf-agent.exe",
        "-Device", "DAS JTAG AURDUINO 46YPEADW",
        "-BackupDir", "${workspaceFolder}\\.m25_flash_backup"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC275: m25 flash PF1 test image",
      "detail": "M25 flasher: write m25_flashtest_tc27x.elf (PF1 sector 0xA021C000 only), reset, run",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\..\\..\\tools\\m25_flash_task.ps1",
        "-Elf", "${workspaceFolder}\\..\\..\\flasher\\m25_flashtest_tc27x.elf",
        "-Agent", "${workspaceFolder}\\agent\\tcf-agent.exe",
        "-Device", "DAS JTAG AURDUINO 46YPEADW",
        "-BackupDir", "${workspaceFolder}\\.m25_flash_backup"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    },
    {
      "label": "TC275: m25 restore PF1 test sector",
      "detail": "M25 flasher: put the sectors written by the last flash back from .m25_flash_backup",
      "type": "process",
      "command": "pwsh",
      "args": [
        "-NoProfile", "-ExecutionPolicy", "Bypass",
        "-File", "${workspaceFolder}\\..\\..\\tools\\m25_flash_task.ps1",
        "-Elf", "${workspaceFolder}\\..\\..\\flasher\\m25_flashtest_tc27x.elf",
        "-Agent", "${workspaceFolder}\\agent\\tcf-agent.exe",
        "-Device", "DAS JTAG AURDUINO 46YPEADW",
        "-BackupDir", "${workspaceFolder}\\.m25_flash_backup",
        "-Restore"
      ],
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "dedicated", "clear": true }
    }
  ]
}
